            <column datatype='datetime' name='[Created Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Opportunity ID]' role='dimension' type='nominal' />
            <column datatype='string' name='[Opportunity Type]' role='dimension' type='nominal' />
            <column datatype='string' name='[Stage]' role='dimension' type='nominal' />
