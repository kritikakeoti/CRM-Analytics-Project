            <column-instance column='[Calculation_1787319533580292]' derivation='None' name='[none:Calculation_1787319533580292:nk]' pivot='key' type='nominal' />
            <column-instance column='[Opportunity Type]' derivation='None' name='[none:Opportunity Type:nk]' pivot='key' type='nominal' />
