      <aliases enabled='yes' />
      <column caption='Average Deal size' datatype='real' name='[Calculation_1787319428034560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Amount])/COUNT([Opportunity ID])' />
      </column>
      <column caption='Win Rate' datatype='real' name='[Calculation_1787319430135809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Stage]= &quot;Closed Won&quot; THEN 1 END)/COUNT([Opportunity ID])' />
      </column>
      <column caption='Close Time (Days)' datatype='integer' name='[Calculation_1787319432568835]' role='measure' type='quantitative'>
