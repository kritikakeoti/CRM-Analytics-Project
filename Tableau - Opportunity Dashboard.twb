    <worksheet name='KPI 3'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#790000' fontname='Tableau Bold' fontsize='16'>Win Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (Opportunity Table (Raw Data))' name='federated.0ow0syf0tfy3dm0zx8tkb0v03mgi' />
          </datasources>
          <datasource-dependencies datasource='federated.0ow0syf0tfy3dm0zx8tkb0v03mgi'>
            <column datatype='integer' name='[Amount]' role='measure' type='quantitative' />
            <column caption='Win Rate' datatype='real' name='[Calculation_1787319430135809]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Stage]= &quot;Closed Won&quot; THEN 1 END)/COUNT([Opportunity ID])' />
            </column>
            <column caption='Open or Closed' datatype='string' name='[Calculation_1787319533580292]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Stage]= &quot;Closed Won&quot; or [Stage]=&quot;Closed Lost&quot;&#13;&#10;then &quot;Closed&quot;&#13;&#10;else &quot;Open&quot;&#13;&#10;END' />
